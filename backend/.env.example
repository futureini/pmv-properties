# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/pmv_properties?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Admin (used once by utils/seedAdmin.js to create the first admin login)
ADMIN_EMAIL=admin@pmvproperties.com
ADMIN_PASSWORD=ChangeThisPassword123!
# Short login name — type this instead of the full email on the admin login page.
ADMIN_USERNAME=admin

# Admin WhatsApp / Call number shown to customers (NOT the owner's number)
ADMIN_CONTACT_NUMBER=917358523204

# Cloudinary — REQUIRED on a live server (Render's disk is wiped on every deploy, so photos can't be stored there).
# On localhost you may leave these blank and photos are saved to backend/uploads/ instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma separated list of allowed origins for CORS (your Vercel frontend URL + localhost)
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Instant admin notifications (both optional — leave blank to disable) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=
